# sidago-frontend environment template (Vite).
# Copy to .env. Values are inlined into the JavaScript bundle at BUILD time and are
# therefore PUBLIC - never put a real secret here. On Vercel set them in the project
# settings and redeploy after a change.

# Backend base URL INCLUDING /api. Socket.io connects to the same host with /api removed.
# Must match the backend PORT (code default 3001).
VITE_API_URL=http://localhost:3001/api

# Key material for the AES-GCM obfuscation of tokens kept in localStorage
# (src/lib/secureStorage.ts). Not real protection - it ships in the bundle. Unset = tokens
# stored in clear text. Changing it forces every user to log in again.
VITE_STORAGE_SECRET_KEY=local-dev-storage-key-change-me
