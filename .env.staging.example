# Staging build of the frontend — copy to .env.staging (git-ignored) or set
# the same keys in Vercel → Project → Settings → Environment Variables for the
# "Preview" environment (feature branches deploy as Preview).
#
#   npm run dev:staging     # local dev server against the staging API
#   npm run build:staging   # production bundle pointing at the staging API
#
# VITE_API_URL is baked into the bundle at build time. The production API
# (https://api.sidago-crm.com/api) must ONLY be set on Vercel's "Production"
# environment, never on Preview, so branch deployments can never reach it.
VITE_API_URL=https://<staging-api-host>/api
VITE_STORAGE_SECRET_KEY=<staging-storage-secret>
